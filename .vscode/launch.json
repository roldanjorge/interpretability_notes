{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-xvs"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Debug: Current Test File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-xvs", "${file}"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        },
        {
            "name": "Debug: Current Test Function",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-xvs", "${file}::${selectedText}"],
            "cwd": "${workspaceFolder}",
            "justMyCode": true
        }
    ]
}
